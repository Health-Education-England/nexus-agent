# ── AI Provider ──────────────────────────────────────────────────────
# Which provider to use: "anthropic" (default) | "bedrock"
# AI_PROVIDER=anthropic

# ── Anthropic ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── AWS Bedrock ──────────────────────────────────────────────────────
# Uncomment the lines below (and set AI_PROVIDER=bedrock) to use Bedrock.
# AWS credentials are resolved via the standard SDK chain
# (env vars / ~/.aws/credentials / IAM role / SSO).
# The IAM principal needs bedrock:InvokeModelWithResponseStream permission.
#
# AI_PROVIDER=bedrock
# BEDROCK_MODEL=us.anthropic.claude-sonnet-4-20250514-v1:0
# AWS_REGION=eu-west-2

# MCP server URLs (JSON array) — both servers included by default when SERVERS is unset
# SERVERS='["http://localhost:3001/mcp","http://localhost:3002/mcp"]'

# Server ports (optional, defaults shown)
# HOST_PORT=8080
# SANDBOX_PORT=8081
# GOLD_GUIDE_PORT=3002
