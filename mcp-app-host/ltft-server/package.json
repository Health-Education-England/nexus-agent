{
  "name": "ltft-mcp-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:app": "vite build",
    "build": "npm run build:app && tsc --noEmit",
    "test": "tsx --test src/server/**/*.test.ts",
