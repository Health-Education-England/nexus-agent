# ── Provider selection ──────────────────────────────────────
# Supported: anthropic | bedrock | ollama  (openai | gemini planned)
AI_PROVIDER=anthropic

# ── Anthropic (direct API) ─────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── AWS Bedrock ────────────────────────────────────────────
# BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
# AWS_REGION=eu-west-2

# ── Ollama (local chat models) ─────────────────────────────
# OLLAMA_MODEL=qwen3.5:9b
# OLLAMA_NUM_CTX=16384

# ── Gold Guide document path ──────────────────────────────
# Path to the parsed Gold Guide markdown file
GOLD_GUIDE_DOCUMENT_PATH=gold-guide-expert/data/markdown/gold-guide.md

# ── RAG Infrastructure ─────────────────────────────────────
# Ollama base URL (shared by chat models and embedding)
# OLLAMA_BASE_URL=http://localhost:11434

# Qdrant (vector database — run via: docker compose up -d)
# QDRANT_URL=http://localhost:6333

# ── Evaluation ─────────────────────────────────────────────
# Reserved for future evaluation harness configuration.
