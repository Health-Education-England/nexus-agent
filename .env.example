# ── Provider selection ──────────────────────────────────────
# Supported: anthropic | bedrock  (openai | gemini planned)
AI_PROVIDER=anthropic

# ── Anthropic (direct API) ─────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── AWS Bedrock ────────────────────────────────────────────
# BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
# AWS_REGION=eu-west-2

# ── Gold Guide document path ──────────────────────────────
# Path to the parsed Gold Guide markdown file
GOLD_GUIDE_DOCUMENT_PATH=gold-guide-expert/data/markdown/gold-guide.md

