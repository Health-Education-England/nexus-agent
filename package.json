{
  "name": "nexus-agent",
  "version": "0.1.0",
  "description": "Gold Guide Expert – agentic QA chatbot with CAG/RAG pipelines and batch evaluation harness",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "start:web": "node dist/src/server.js",
    "dev": "npx tsx src/main.ts",
    "dev:mcp-app-host": "npm --prefix mcp-app-host run dev:e2e",
    "dev:web": "npx tsx src/server.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "docs:setup-parser": "cd gold-guide-expert && python3 -m venv venv && source venv/bin/activate && pip install -r scripts/requirements.txt",
    "docs:parse": "cd gold-guide-expert && source venv/bin/activate && python scripts/parse-pdf.py",
    "docs:clean": "npx tsx gold-guide-expert/scripts/clean-markdown.ts",
    "docs:canonicalise": "npx tsx gold-guide-expert/scripts/canonicalise.ts",
    "docs": "npm run docs:parse && npm run docs:clean && npm run docs:canonicalise",
    "models:list:anthropic": "npx tsx gold-guide-expert/scripts/list-anthropic-models.ts",
    "rag:services:up": "docker compose up -d",
    "rag:services:down": "docker compose down",
    "rag:ingest": "npx tsx gold-guide-expert/scripts/ingest-vectors.ts",
    "eval:cag": "npx tsx gold-guide-expert/evaluation/runner.ts --dataset development --pipeline cagCheap",
    "eval:rag": "npx tsx gold-guide-expert/evaluation/runner.ts --dataset development --pipeline naiveRagCheap"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@aws-sdk/client-bedrock-runtime": "^3.998.0",
    "@qdrant/js-client-rest": "^1.17.0",
    "dotenv": "^17.2.3",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3"
  }
}
